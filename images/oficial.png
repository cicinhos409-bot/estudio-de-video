<div class="soon" id="em" role="dialog" aria-label="Pra onde envio seu acesso?"><div class="box">
  <button class="x" type="button" aria-label="Fechar">×</button>
  <img src="media/yuri-profile.jpg" alt="">
  <h3>Pra onde envio <span class="o">seu acesso?</span></h3>
  <p>Digita seu e-mail e você vai direto pro checkout.</p>
  <form id="em-f" novalidate>
    <input id="em-in" name="email" type="email" inputmode="email" autocomplete="email" placeholder="voce@email.com" required>
    <input name="hp" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
    <button class="buy" type="submit">Continuar pro checkout →</button>
  </form>
  <small class="em-note">Mando um lembrete se você não terminar, e novidades de vez em quando. Cancela quando quiser.</small>
</div></div>
<div class="dock" id="dock"><div class="t">Estúdio de Vídeos<b>R$297 · pagamento único</b></div><a href="#" class="js-checkout">Quero o Estúdio</a></div>

<script>
const CHECKOUT_URL = 'https://pay.kiwify.com.br/Dr2h6zB';
const store = (k, v) => { try { return v === undefined ? localStorage.getItem(k) : localStorage.setItem(k, v); } catch {} };
const $$ = s => document.querySelectorAll(s);
// checkout keeps the page's UTMs (Utmify) and pre-fills the email when we have it
const checkoutHref = (email) => {
  try {
    const u = new URL(CHECKOUT_URL);
    new URLSearchParams(location.search).forEach((v, k) => { if (k !== 'vsldebug' && !u.searchParams.has(k)) u.searchParams.append(k, v); });
    if (email) u.searchParams.set('email', email);
    return u.toString();
  } catch { return CHECKOUT_URL; }
};
$$('.js-checkout').forEach(a => a.href = checkoutHref());

// First-party stats (server/stats.mjs): anonymous, no cookies. One beacon per step.
// Which video sent them: each reel's DM link carries ?s=<name>. The latest one is kept on the device, so a
// visitor who comes back later without the link still counts for the video that brought them.
const SRC = (() => {
  const q = new URLSearchParams(location.search);
  const u = (q.get('s') || q.get('utm_campaign') || q.get('utm_source') || q.get('ref') || '').toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 40);
  if (u) store('lm_src', u);
  return u || store('lm_src') || '';
})();
const ev = () => {};
ev('view', { r: document.referrer, p: location.pathname });
let sc50 = false, sc90 = false;
addEventListener('scroll', () => {
  const f = (scrollY + innerHeight) / document.documentElement.scrollHeight;
  if (!sc50 && f > .5) { sc50 = true; ev('scroll50'); }
  if (!sc90 && f > .9) { sc90 = true; ev('scroll90'); }
}, { passive: true });

// Checkout is Gumroad (Polar refused the product). Before it, one step asks where to send the skill: the email
// goes to /api/sub (server/buyers.mjs), which sends up to 3 reminders to people who don't finish and stops the
// moment Gumroad's sale ping arrives. The email is passed on so Gumroad's form comes pre-filled.
const em = document.getElementById('em'), emForm = document.getElementById('em-f'), emIn = document.getElementById('em-in');
const goCheckout = (email) => { ev('checkout'); location.href = checkoutHref(email); };
let known = store('lm_email') || '';
$$('.js-checkout').forEach(a => {
  a.addEventListener('click', e => {
    e.preventDefault();
    ev('cta');
    if (known) return goCheckout(known);
    em.classList.add('on'); setTimeout(() => emIn.focus(), 60);
  });
});
em.addEventListener('click', e => { if (e.target === em || e.target.closest('.x')) em.classList.remove('on'); });
emForm.addEventListener('submit', async e => {
  e.preventDefault();
  const email = emIn.value.trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { emIn.focus(); emForm.classList.add('bad'); return; }
  const btn = emForm.querySelector('button'); btn.disabled = true; btn.textContent = 'Um momento…';
  try {
    await Promise.race([
      fetch('/api/sub', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, hp: emForm.hp.value, src: SRC }) }),
      new Promise(r => setTimeout(r, 2500)),   // never hold the sale hostage to our server
    ]);
  } catch {}
  store('lm_email', email);
  goCheckout(email);
});

// ----- VSL: tap pauses/plays, no seek; the buy buttons only show at the end of the pitch -----
const REVEAL_BEFORE_END = 35;   // 30/10: libera no inicio da oferta (~208 s de 243 s), um pouco antes do fim
const film = document.getElementById('film'), demoBox = document.getElementById('demo');
const shield = document.getElementById('shield'), unmute = document.getElementById('unmute'), bar = document.getElementById('bar');
const cta1 = document.getElementById('cta1');
const DEBUG = /[?&]vsldebug\b/.test(location.search);   // ?vsldebug libera pular o video pra testar o fim
let revealAt = null, revealed = false, lastT = 0, allowSeek = false, userStarted = false;
function reveal(fromPlayback) {
  if (revealed) return;
  revealed = true;
  document.body.classList.add('revealed');
  ev('reveal');
  if (fromPlayback) {
    const r = cta1.getBoundingClientRect();
    if (r.top < 0 || r.bottom > innerHeight) cta1.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
  }
}
const setRevealFromDuration = () => { const d = film.duration; if (isFinite(d) && d > 0) revealAt = Math.max(0, d - REVEAL_BEFORE_END); };
film.addEventListener('loadedmetadata', setRevealFromDuration);
if (film.readyState >= 1) setRevealFromDuration();
film.controls = false;
film.muted = true;
film.addEventListener('timeupdate', () => {
  const t = film.currentTime, d = film.duration;
  if (!film.seeking) lastT = t;
  if (isFinite(d) && d > 0) bar.style.width = (100 * (1 - Math.pow(1 - Math.min(1, t / d), 2.2))).toFixed(2) + '%';
  if (revealAt !== null && t >= revealAt) reveal(true);
});
film.addEventListener('seeking', () => {
  if (allowSeek || DEBUG) return;
  if (Math.abs(film.currentTime - lastT) > 1) film.currentTime = lastT;
});
film.addEventListener('seeked', () => { allowSeek = false; });
// only counts as the end if it really got there (a network error mid-way fires 'ended' early)
film.addEventListener('ended', () => {
  const d = film.duration;
  if (isFinite(d) && film.currentTime >= d - 5) { reveal(true); bar.style.width = '100%'; }
  else recover();
});
let recovering = false;
function recover() {
  if (recovering) return;
  recovering = true;
  const t = lastT, wasMuted = film.muted;
  allowSeek = true;
  film.load();
  film.addEventListener('loadedmetadata', () => {
    try { film.currentTime = t; } catch {}
    film.muted = wasMuted;
    film.play().catch(() => {});
    recovering = false;
  }, { once: true });
}
film.addEventListener('error', recover);
const toggle = () => { if (film.ended) return; if (film.paused) film.play().catch(() => {}); else film.pause(); };
film.addEventListener('pause', () => { if (userStarted) demoBox.classList.add('is-paused'); });
film.addEventListener('play', () => demoBox.classList.remove('is-paused'));
film.addEventListener('ratechange', () => { if (film.playbackRate !== 1) film.playbackRate = 1; });
shield.addEventListener('click', e => { e.preventDefault(); toggle(); });
['dblclick', 'contextmenu'].forEach(t => {
  shield.addEventListener(t, e => { e.preventDefault(); e.stopPropagation(); });
  film.addEventListener(t, e => { e.preventDefault(); e.stopPropagation(); });
});
addEventListener('keydown', e => {
  const k = e.key, tag = (e.target.tagName || '').toLowerCase();
  if (tag === 'input' || tag === 'textarea' || tag === 'button' || tag === 'a') return;
  if ([' ', 'Spacebar', 'k', 'K'].includes(k)) { if (userStarted) { e.preventDefault(); toggle(); } return; }
  if (['j', 'J', 'l', 'L', 'ArrowLeft', 'ArrowRight', 'MediaTrackNext', 'MediaTrackPrevious', 'MediaFastForward', 'MediaRewind'].includes(k)) e.preventDefault();
}, true);
if ('mediaSession' in navigator) {
  ['seekbackward', 'seekforward', 'seekto', 'previoustrack', 'nexttrack'].forEach(a => { try { navigator.mediaSession.setActionHandler(a, () => {}); } catch {} });
}
// muted autoplay + "your video already started" overlay; the tap restarts it from 0 with sound
film.play().catch(() => {
  document.getElementById('unmute-t1').textContent = 'Toque para assistir';
  document.getElementById('unmute-t2').textContent = 'Com som';
});
unmute.addEventListener('click', e => {
  e.preventDefault();
  userStarted = true; unmute.hidden = true; allowSeek = true;
  try { film.currentTime = 0; } catch {}
  lastT = 0; film.muted = false; film.volume = 1; ev('play');
  film.play().catch(() => { film.muted = true; film.play().catch(() => {}); unmute.hidden = false; });
});

// the reels: fetched ~1.5 screens early, played only while visible
const fan = document.getElementById('fan'), fanvid = document.getElementById('fanvid');
if (fanvid) {
  const fanTry = () => fanvid.play().catch(() => { if (fan.dataset.state !== 'playing' && fanvid.readyState >= 2) fan.dataset.state = 'blocked'; });
  new IntersectionObserver((es, o) => es.forEach(e => { if (e.isIntersecting) { fanvid.preload = 'auto'; fanvid.src = fanvid.dataset.src; o.disconnect(); } }), { rootMargin: '1500px 0px' }).observe(fanvid);
  new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { if (fanvid.src) fanTry(); } else fanvid.pause(); }), { threshold: .2 }).observe(fanvid);
  fanvid.addEventListener('playing', () => { fan.dataset.state = 'playing'; });
  fanvid.addEventListener('canplay', () => { const r = fanvid.getBoundingClientRect(); if (r.top < innerHeight && r.bottom > 0) fanTry(); });
  const fanplayBtn = document.getElementById('fanplay');
  if (fanplayBtn) fanplayBtn.addEventListener('click', () => { fan.dataset.state = 'loading'; fanTry(); });
}

const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .12 });
$$('.rv').forEach(el => io.observe(el));

// sticky bar once the first buy button has scrolled away
const dock = document.getElementById('dock');
new IntersectionObserver(([e]) => dock.classList.toggle('on', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(document.getElementById('cta1'));

// Auto-play style card videos when visible
const styleVids = document.querySelectorAll('.sc-vid video');
if (styleVids.length) {
  const vObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.play().catch(()=>{}); }
      else { e.target.pause(); }
    });
  }, { threshold: 0.3 });
  styleVids.forEach(v => vObs.observe(v));
}

// Auto-play phone fan videos when visible
const fanVids = document.querySelectorAll('.pf-phone video');
if (fanVids.length) {
  const fObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.play().catch(()=>{}); }
      else { e.target.pause(); }
    });
  }, { threshold: 0.3 });
  fanVids.forEach(v => fObs.observe(v));
}
</script>

<script async src="https://painel-vsl.suporteselos.workers.dev/s.js"></script>
</body>
